type AssetData = record { balance : nat; name : text };
type AssetInfo = record {
  asset_name : text;
  image : text;
  principal_id : principal;
  symbol : text;
};
type Certificate = record { certificate : blob; witness : blob };
type Challenge = record { base64_img : text };
type CycleAlert = record { is_exhausted : bool; is_warning : bool };
type Error = variant {
  NormalizedSupply;
  TooManyRequests;
  ConversionErrorToU128;
  NoCollateralFound;
  NoDebtToRepay;
  InvalidCaptcha;
  TotalCollateraLessThan;
  NoFaucetReservesFound;
  SupportNotFound;
  FailedToReleaseLock;
  NoCanisterIdFound;
  ErrorBurnDebtTokens;
  SupplyCapExceeded;
  ErrorDecoding;
  InvalidAmount;
  ErrorInterestRate;
  AuditorNotFound;
  UserCannotBeLiquidated;
  AmountTooMuch;
  TokenNotTransfered;
  CaptchaMismatch;
  ErrorMintDebtTokens;
  AdminNotFound;
  NoUserReserveDataFound;
  ErrorGetBalance;
  CaptchaExpired;
  LockAcquisitionFailed;
  ExchangeRateError;
  ErrorMintDTokens;
  ErrorFaucetTokens;
  InvalidAssetLength;
  InvalidCanister;
  LTVGreaterThanThreshold;
  ReserveInactive;
  InvalidVariableName;
  AuditorAlreadyExists;
  SupportAlreadyExists;
  WithdrawMoreThanSupply;
  ErrorMintTokens;
  BorrowingNotEnabled;
  NotAnAuditor;
  CaptchaNotFound;
  InvalidPrincipal;
  AllowanceQueryFailed;
  DeveloperNotFound;
  ErrorNotController;
  NoReserveDataFound;
  LiquidationProtocolfeeIsHigher;
  LowWalletBalance;
  InvalidBurnAmount;
  CaptchaLimitReached;
  AnonymousPrincipal;
  InvalidUserId;
  UserFaucetReserveNotFound;
  ErrorDTokenBalanceLessThan;
  NegativeAmount;
  EmailError;
  ErrorPriceCache;
  RoleAlreadyExistsForUser;
  InvalidRole;
  NotADeveloper;
  InvalidAssetImageUrl;
  InvalidUser;
  AllowanceTooLow;
  EmptyAsset;
  InvalidValue;
  TokenAlreadyExist;
  RateLimitExceeded;
  UserRoleNotFound;
  MaxAmount;
  FeeExceedsAmount;
  ErrorParsingPrincipal;
  ReserveFrozen;
  DeveloperAlreadyExists;
  LessRewardAmount;
  ErrorRollBack;
  AmountExceedsLimit;
  ErrorBurnDTokens;
  NoPriceCache;
  LowPlatformBalance;
  ConversionErrorFromTextToPrincipal;
  MaxAmountPlatform;
  NotFoundAssetPrincipal;
  LockOperationInProgess;
  ExceedsRemainingLimit;
  BorrowCapExceeded;
  InsufficientLiquidity;
  BlockedForOneHour;
  NotASupport;
  AmountSubtractionError;
  ErrorSupplyToken;
  RewardIsHigher;
  ErrorEncoding;
  HealthFactorLess;
  UnauthorizedAccess;
  ConnectedWalletInvalid;
  ErrorCreatingCanister;
  RollbackFailed;
  ReservePaused;
  ErrorUpdateCanisterSetting;
  ErrorBurnTokens;
  RepayMoreThanDebt;
  InvalidMintAmount;
  ErrorRawResponse;
  UserNotFound;
  CalculateUserAccountDataError;
  ControllerNotFound;
  AdminAlreadyExists;
  NormalizedDebt;
  UserCollateralLessThanReward;
  DebtTokenBalanceLessThan;
  CaptchaAlreadyExists;
};
type ExecuteBorrowParams = record { asset : text; amount : nat };
type ExecuteLiquidationParams = record {
  debt_asset : text;
  reward_amount : nat;
  collateral_asset : text;
  on_behalf_of : principal;
  amount : nat;
};
type ExecuteRepayParams = record {
  asset : text;
  on_behalf_of : opt principal;
  amount : nat;
};
type ExecuteSupplyParams = record {
  asset : text;
  can_be_collateral : bool;
  amount : nat;
};
type FaucetReserve = record { faucet_limit : nat; faucet_usage : nat };
type FaucetReserves = record {
  reserves : opt vec record { text; FaucetReserve };
};
type ReserveConfiguration = record {
  ltv : nat;
  liquidation_protocol_fee : nat;
  supply_cap : nat;
  borrow_cap : nat;
  reserve_factor : nat;
  borrowing_enabled : bool;
  liquidation_bonus : nat;
  liquidation_threshold : nat;
};
type ReserveData = record {
  id : nat16;
  asset_name : text;
  asset_borrow : nat;
  can_be_collateral : opt bool;
  debt_token_canister : opt principal;
  last_update_timestamp : nat64;
  liquidity_index : nat;
  d_token_canister : opt principal;
  asset_supply : nat;
  current_liquidity_rate : nat;
  borrow_rate : nat;
  configuration : ReserveConfiguration;
  accure_to_platform : nat;
  debt_index : nat;
};
type Result = variant { Ok : text; Err : Error };
type Result_1 = variant { Ok; Err : Error };
type Result_10 = variant {
  Ok : record { principal; Certificate };
  Err : Error;
};
type Result_11 = variant { Ok : principal; Err : Error };
type Result_12 = variant {
  Ok : record { ReserveData; Certificate };
  Err : Error;
};
type Result_13 = variant {
  Ok : record { record { nat; nat; nat; nat; nat; nat; bool }; Certificate };
  Err : Error;
};
type Result_14 = variant { Ok : record { UserData; Certificate }; Err : Error };
type Result_15 = variant {
  Ok : record { FaucetReserves; Certificate };
  Err : Error;
};
type Result_16 = variant { Ok : record { bool; Certificate }; Err : Error };
type Result_17 = variant { Ok; Err : text };
type Result_18 = variant { Ok : TokenAlert; Err : Error };
type Result_2 = variant { Ok : Challenge; Err : Error };
type Result_3 = variant { Ok : UserData; Err : Error };
type Result_4 = variant { Ok : CycleAlert; Err : Error };
type Result_5 = variant { Ok : record { nat; Certificate }; Err : Error };
type Result_6 = variant { Ok : nat; Err : Error };
type Result_7 = variant { Ok : vec text; Err : Error };
type Result_8 = variant {
  Ok : vec record { principal; UserAccountData; UserData };
  Err : Error;
};
type Result_9 = variant {
  Ok : vec record { principal; vec text };
  Err : Error;
};
type TokenAlert = record {
  asset_name : text;
  is_exhausted : bool;
  is_warning : bool;
};
type UserAccountData = record {
  ltv : nat;
  available_borrow : nat;
  has_zero_ltv_collateral : bool;
  debt : nat;
  collateral : nat;
  health_factor : nat;
  liquidation_threshold : nat;
};
type UserData = record {
  reserves : opt vec record { text; UserReserveData };
  user_id : opt text;
};
type UserReserveData = record {
  can_be_collateral : bool;
  last_update_timestamp : nat64;
  d_token_balance : nat;
  is_collateral : bool;
  liquidity_index : nat;
  variable_borrow_index : nat;
  reserve : text;
  debt_token_balance : nat;
  is_using_as_collateral_or_borrow : bool;
  is_borrowed : bool;
};
service : (principal) -> {
  add_admin_test : (text, principal) -> (Result);
  add_user_with_role : (principal, text) -> (Result);
  admin_restart_reset_task : () -> (Result_1);
  check_is_tester : () -> (bool) query;
  create_captcha : () -> (Result_2);
  create_user_reserve_with_low_health : (text, text, nat, nat) -> (Result_3);
  cycle_alert : () -> (Result_4) query;
  cycle_checker : () -> (Result_5) query;
  execute_borrow : (ExecuteBorrowParams) -> (Result_6);
  execute_liquidation : (ExecuteLiquidationParams) -> (Result_6);
  execute_repay : (ExecuteRepayParams) -> (Result_6);
  execute_supply : (ExecuteSupplyParams) -> (Result_6);
  execute_withdraw : (ExecuteSupplyParams) -> (Result_6);
  faucet : (text, nat) -> (Result_6);
  get_all_assets_certified : () -> (vec AssetInfo, Certificate) query;
  get_all_logs : () -> (Result_7) query;
  get_all_user_list : (nat64, nat64, bool) -> (Result_8);
  get_all_users_certified : () -> (
      vec record { principal; UserData },
      Certificate,
    ) query;
  get_all_users_with_roles : () -> (Result_9) query;
  get_asset_principal_certified : (text) -> (Result_10) query;
  get_cached_exchange_rate_certified : (text) -> (Result_5) query;
  get_canister_id_by_name : (text) -> (Result_11) query;
  get_reserve_data_certified : (text) -> (Result_12) query;
  get_total_users : () -> (nat64, Certificate) query;
  get_transfer_fee : (text) -> (Result_5) query;
  get_user_account_data : (
      opt principal,
      opt vec AssetData,
      opt vec AssetData,
    ) -> (Result_13) query;
  get_user_data : (principal) -> (Result_14) query;
  get_user_faucet_data : (principal) -> (Result_15) query;
  guard_admin_only : () -> (Result_1) query;
  init_logging : (bool) -> ();
  initialize : (text, ReserveData, opt principal, text) -> (Result_1);
  is_transfer_allowed : (principal, principal, text, nat) -> (bool);
  is_user_blocked : () -> (Result_16) query;
  mock_price_data : () -> (Result_1);
  receive_and_load_data_backup : (nat64) -> (Result_17);
  remove_user_role : (principal, text) -> (Result);
  reset_reserve_value : (text, text, nat) -> (Result_1);
  send_backup_data_to_canister : () -> (Result_17);
  set_canister_id : (text, principal) -> (Result_1);
  to_check_controller : () -> (bool) query;
  toggle_collateral : (text, nat, nat) -> (Result_1);
  token_balance_alert : (text) -> (Result_18);
  update_reserves_price : () -> (Result_1);
  user_normalized_debt_certified : (ReserveData) -> (Result_5) query;
  user_normalized_supply_certified : (ReserveData) -> (Result_5) query;
  users_transfer_changes : (principal, principal, text, nat) -> (bool);
  verify_captcha : (text) -> (Result_1);
}
